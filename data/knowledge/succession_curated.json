{
  "version": 1,
  "about": "Hand-curated inputs of the succession model (packages/core/src/succession.ts): which tanda follows which well. `pnpm knowledge:succession` (scripts/build_succession.ts) copies this file into data/knowledge/succession.json beside the transition counts it mines from the DJ sets. Voice classes are estimates from the recordings (a timbre class, not a range test): high-tenor = light, bright, high-placed voices; tenor = the middle lyric voices; baritone = dark, low voices; female. A singer missing here is simply not compared. Lineages are sound families: orchestras whose leader or arrangers came out of another's band and kept its sound, so back to back they read as the same orchestra again.",
  "points": {
    "about": "the parts of the score, in points (positive = follows well); score = tanh(sum / scale)",
    "scale": 12,
    "energy": { "fit": 4, "slack": 4, "perPoint": 0.5, "min": -10 },
    "era": { "near": 2, "slack": 3, "perYear": 1, "min": -10, "bigJump": -4, "guardiaUntil": 1935, "lateFrom": 1950, "vmFactor": 0.5 },
    "voice": { "same": { "high-tenor": -5, "tenor": -2, "baritone": -2, "female": -1 }, "contrast": 2, "sameSinger": -6 },
    "tempo": { "near": 1, "slack": 6, "perBpm": 0.4, "min": -6 },
    "key": { "near": 1, "far": -1, "brightJumpHz": 800, "bright": -1 },
    "lineage": -3,
    "corpus": { "alpha": 4, "minOut": 3, "perLog2": 2.5, "min": -3, "max": 6, "familyPerCount": 0.5, "familyMax": 2, "common": 3 },
    "styleLift": { "perLog2": 3, "max": 3 },
    "learned": { "perPoint": 1.5, "min": -1.5, "max": 4.5 },
    "good": 6,
    "warn": -6
  },
  "styleMatrix": {
    "about": "tango → tango, row = the tanda before, column = the next one; classes as transitions.ts styleClass (R+ hard-driving rhythmic, R rhythmic, L lyrical, B balanced, D dramatic). Alternation is rewarded (D'Arienzo → Di Sarli), two rhythmic in a row tire the floor, two dramatic never.",
    "R+": { "R+": -8, "R": -4, "L": 5, "B": 2, "D": 3 },
    "R": { "R+": -4, "R": -3, "L": 4, "B": 1, "D": 3 },
    "L": { "R+": 5, "R": 4, "L": -3, "B": 1, "D": 1 },
    "B": { "R+": 2, "R": 1, "L": 1, "B": -2, "D": 1 },
    "D": { "R+": 3, "R": 4, "L": -3, "B": 1, "D": -10 }
  },
