{
  "name": "@tdj/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TDJ for macOS and iPadOS (Tauri 2). Release flow: docs/RELEASING.md",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "ui": "node scripts/build-ui.mjs",
    "icons": "node src-tauri/icons/src/render.mjs",
    "build:mac": "bash ../../scripts/release/mac-build.sh",
    "store:capture": "tsx store/capture.ts",
    "store:compose": "tsx store/compose.ts",
    "store:sheet": "tsx store/contact-sheet.ts",
    "screenshots": "tsx store/capture.ts && tsx store/compose.ts && tsx store/contact-sheet.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --all-features",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
