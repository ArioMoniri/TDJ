# TDJ App Store lanes (docs/RELEASING.md). Every lane uses the App Store Connect API key, never an Apple ID.
# Key: APP_STORE_CONNECT_KEY_ID + APP_STORE_CONNECT_ISSUER_ID, and either APP_STORE_CONNECT_PRIVATE_KEY (the .p8
# text, CI) or the file ~/.appstoreconnect/private_keys/AuthKey_TDJ.p8 (the rented Mac), or
# APP_STORE_CONNECT_KEY_PATH. Metadata/screenshot lanes run on Linux; upload lanes need the built binaries.

opt_out_usage
default_platform(:ios)

APP_ID = ENV.fetch("TDJ_APP_BUNDLE_ID", "com.ariomoniri.tdj")
META = File.expand_path("metadata", __dir__)

def asc_key
  path = ENV["APP_STORE_CONNECT_KEY_PATH"]
  path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_TDJ.p8") if path.to_s.empty?
  content = ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
  args = { key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"), issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"), in_house: false }
  if content && !content.empty?
    args[:key_content] = content
  elsif File.exist?(path)
    args[:key_filepath] = path
  else
    UI.user_error!("No App Store Connect key: set APP_STORE_CONNECT_PRIVATE_KEY or put the .p8 at #{path}")
  end
  app_store_connect_api_key(**args)
end

def review_info
  {
    first_name: ENV["TDJ_REVIEW_FIRST_NAME"],
    last_name: ENV["TDJ_REVIEW_LAST_NAME"],
    email_address: ENV["TDJ_REVIEW_EMAIL"],
    phone_number: ENV["TDJ_REVIEW_PHONE"],
    demo_required: false,
    notes: File.read(File.join(META, "review_information", "notes.txt")),
  }.compact
end

# App Review answers: HTTPS + OS crypto only; third-party music (played through the services' own APIs, which
# grant the rights); no advertising identifier
SUBMISSION_INFO = {
  export_compliance_uses_encryption: false,
  add_id_info_uses_idfa: false,
  content_rights_contains_third_party_content: true,
  content_rights_has_rights: true,
}.freeze

# App previews (`pnpm store:creative`, store/creative/preview.ts): app_previews/<locale>/ holds the iPhone (IPHONE_67, the
# 6.9" slot; 6.5" falls back to it) and iPad 13" (IPAD_PRO_3GEN_129) videos, app_previews_mac/<locale>/ the Mac one
# (DESKTOP). deliver tells the slot from the file name; the poster frame is the frame at 5 s.
PREVIEW_FRAME = "00:00:05:00"

def previews_for(platform)
  dir = File.expand_path(platform == "osx" ? "app_previews_mac" : "app_previews", __dir__)
  return {} unless Dir.glob(File.join(dir, "*", "*.{mp4,mov,m4v}")).any?
  { app_previews_path: dir, preview_frame_time_code: PREVIEW_FRAME, overwrite_preview_videos: true }
end

def deliver_common(platform, screenshots)
  {
    api_key: asc_key,
    app_identifier: APP_ID,
    platform: platform,
    metadata_path: META,
    screenshots_path: screenshots,
    skip_screenshots: !File.directory?(screenshots),
    overwrite_screenshots: true,
    app_rating_config_path: File.join(META, "app_rating_config.json"),
    app_review_information: review_info,
    precheck_include_in_app_purchases: false,
    run_precheck_before_submit: false,
    force: true, # no HTML preview prompt (CI / unattended Mac)
  }.merge(previews_for(platform))
end

# iOS screenshots (`pnpm store:creative`, apps/desktop/store/creative): screenshots/<locale>/ holds the iPhone 6.9" and
# 6.5" sets and the iPad 13" set; deliver picks each slot from the image size. iPhone Duo (screenshots_duo/) and the
# product page Header and Search Results images (product_page/) go up after deliver through the App Asset Library
# (scripts/asset-library.mjs; docs/RELEASING.md). The iPad 12.9" set (2048x2732) shares the 13" slot
# in App Store Connect, so it lives in screenshots_ipad129/ and goes up instead of the 13" set only with ipad:129.
def ios_screenshots(o)
  base = File.expand_path("screenshots", __dir__)
  return base unless o[:ipad].to_s == "129"
  require "fileutils"
  require "tmpdir"
  dir = Dir.mktmpdir("tdj-shots")
  Dir.glob(File.join(base, "*")).select { |d| File.directory?(d) }.each do |loc|
    out = File.join(dir, File.basename(loc))
    FileUtils.mkdir_p(out)
    FileUtils.cp(Dir.glob(File.join(loc, "*_iphone*.jpg")), out)
    FileUtils.cp(Dir.glob(File.join(File.expand_path("screenshots_ipad129", __dir__), File.basename(loc), "*.jpg")), out)
  end
  dir
end

platform :ios do
  desc "Upload iPhone + iPad metadata, screenshots and app previews (no binary); ipad:129 sends the 12.9-inch iPad set"
  lane :metadata do |o|
    deliver(**deliver_common("ios", ios_screenshots(o)), skip_binary_upload: true)
  end

  desc "Upload an IPA to TestFlight: fastlane ios beta ipa:path/TDJ.ipa"
  lane :beta do |o|
    pilot(api_key: asc_key, app_identifier: APP_ID, ipa: o[:ipa], skip_waiting_for_build_processing: true,
          changelog: File.read(File.join(META, "en-US", "release_notes.txt")))
  end

  desc "Submit the iOS (iPhone + iPad) version for App Review (build_number: as App Store Connect shows it, e.g. 1.0.0.457765; app_version:), phased release, manual release"
  lane :submit do |o|
    deliver(**deliver_common("ios", File.expand_path("screenshots", __dir__)),
            skip_binary_upload: true, submit_for_review: true, build_number: o[:build_number], app_version: o[:app_version],
            automatic_release: false, phased_release: true,
            submission_information: SUBMISSION_INFO)
  end
end

# The Mac slot takes one 16:10 size: 2880x1800 (screenshots_mac/) by default, 2560x1600 (screenshots_mac2560/) with mac:2560.
def mac_screenshots(o)
  File.expand_path(o[:mac].to_s == "2560" ? "screenshots_mac2560" : "screenshots_mac", __dir__)
end

platform :mac do
  desc "Upload Mac metadata, screenshots and the app preview (no binary); mac:2560 sends the 2560x1600 set"
  lane :metadata do |o|
    deliver(**deliver_common("osx", mac_screenshots(o)), skip_binary_upload: true)
  end

  desc "Upload a Mac App Store pkg to TestFlight: fastlane mac beta pkg:path/TDJ.pkg"
  lane :beta do |o|
    pilot(api_key: asc_key, app_identifier: APP_ID, pkg: o[:pkg], app_platform: "osx",
          skip_waiting_for_build_processing: true,
          changelog: File.read(File.join(META, "en-US", "release_notes.txt")))
  end

  desc "Submit the Mac version for App Review (build_number:, app_version:)"
  lane :submit do |o|
    deliver(**deliver_common("osx", File.expand_path("screenshots_mac", __dir__)),
            skip_binary_upload: true, submit_for_review: true, build_number: o[:build_number], app_version: o[:app_version],
            automatic_release: false, phased_release: true,
            submission_information: SUBMISSION_INFO)
  end
end
