{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app's own pages (the bundled, standalone UI) in the main window. No remote origin has a static grant: a TDJ server is an opt-in link, and only a development build without the bundle shows its pages (lib.rs grant_remote).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "allow-get-native-info",
    "allow-set-server",
    "allow-unlink-server",
    "allow-secret-set",
    "allow-secret-has",
    "allow-secret-delete",
    "allow-net-fetch",
    "allow-model-fetch",
    "allow-acp-spawn",
    "allow-acp-write",
    "allow-acp-read",
    "allow-acp-kill",
    "allow-spotify-token",
    "allow-spotify-access",
    "allow-spotify-logout",
    "allow-byo-youtube-search",
    "allow-byo-google-redirect",
    "allow-byo-oauth-exchange",
    "allow-byo-oauth-access",
    "allow-byo-oauth-logout",
    "allow-start-login",
    "allow-forget-sessions",
    "allow-open-external",
    "allow-save-file",
    "allow-print-page",
    "allow-floor-window",
    "allow-keep-awake",
    "allow-now-playing",
    "allow-folder-add",
    "allow-folder-list",
    "allow-folder-remove",
    "allow-folder-files",
    "allow-folder-read",
    "allow-cue-devices",
    "allow-cue-play",
    "allow-cue-stop",
    "allow-check-updates",
    "allow-audio-route",
    "allow-audio-route-picker",
    "allow-audio-set-output",
    "allow-audio-night",
    "allow-power-state",
    "allow-power-saver",
    "allow-midi-ports",
    "allow-midi-open",
    "allow-midi-close",
    "allow-midi-send"
  ]
}
