{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "Pages served by the TDJ cloud (remote mode). A self-hosted server gets the same set at runtime after the DJ trusts it (lib.rs grant_remote). No server switching or session wiping from a remote page.",
  "windows": ["main"],
  "remote": { "urls": ["https://d3k5k2c1l0s5ri.cloudfront.net/*"] },
  "permissions": [
    "core:event:default",
    "allow-get-native-info",
    "allow-start-login",
    "allow-open-external",
    "allow-save-file",
    "allow-print-page",
    "allow-keep-awake",
    "allow-now-playing",
    "allow-folder-add",
    "allow-folder-list",
    "allow-folder-remove",
    "allow-folder-files",
    "allow-folder-read",
    "allow-cue-devices",
    "allow-cue-play",
    "allow-cue-stop",
    "allow-check-updates"
  ]
}
