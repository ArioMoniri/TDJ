<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>T-DJ</string>
  <!-- merged into the iPadOS Info.plist by the Tauri iOS project -->
  <key>ITSAppUsesNonExemptEncryption</key><false/>
  <!-- the Booth keeps playing with the screen locked -->
  <key>UIBackgroundModes</key><array><string>audio</string></array>
  <!-- open the Spotify app for Spotify playback (App Remote) -->
  <key>LSApplicationQueriesSchemes</key><array><string>spotify</string></array>
  <!-- 2026-11: the Booth's room meter (Auto master), only after the DJ switches it on -->
  <key>NSMicrophoneUsageDescription</key><string>The Booth's room meter listens to how loud the room is, only when you turn it on, to keep the music's level steady over the crowd. Audio is never recorded or sent anywhere.</string>
  <key>NSLocalNetworkUsageDescription</key><string>TDJ connects to a TDJ server or DJ agent on your local network when you choose one.</string>
  <!-- one universal app (TARGETED_DEVICE_FAMILY 1,2, scripts/release/mac-build.sh). iPhone: portrait, the layout the
       phone UI is built and tested for (tab bar, Booth transport above the home indicator); the un-suffixed key is the
       iPhone's because the iPad has its own below -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <key>UISupportedInterfaceOrientations~iphone</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <!-- iPad: every orientation, Split View, Slide Over and Stage Manager -->
  <key>UIRequiresFullScreen</key><false/>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <!-- launch screen: the ink background of the icon (no storyboard needed since iOS 14) -->
  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key><string>LaunchBackground</string>
  </dict>
  <!-- round 23: dark glyphs on the light theme, light on the dark one (LightContent drew white on cream) -->
  <key>UIStatusBarStyle</key><string>UIStatusBarStyleDefault</string>
  <!-- §13: a shared night (.tdjnight) opens in T-DJ from Files, AirDrop, Mail and Messages -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>T-DJ Night</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>LSItemContentTypes</key><array><string>com.ariomoniri.tdj.night</string></array>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>com.ariomoniri.tdj.night</string>
      <key>UTTypeDescription</key><string>T-DJ Night</string>
      <key>UTTypeConformsTo</key><array><string>public.json</string><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>tdjnight</string></array>
        <key>public.mime-type</key><array><string>application/vnd.tdj.night+json</string></array>
      </dict>
    </dict>
  </array>
  <key>LSSupportsOpeningDocumentsInPlace</key><false/>
</dict>
</plist>
