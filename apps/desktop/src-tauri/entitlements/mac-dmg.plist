<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Developer ID build (DMG from GitHub Releases): hardened runtime, not sandboxed (the local agent bridge,
       r22-acp-plan.md, starts the DJ's own tools later). WebKit's JIT runs in its own process, so no JIT or
       unsigned-memory exceptions are needed. -->
  <!-- 2026-11: the Booth's room meter (microphone), hardened runtime: only after the DJ switches it on -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- docs/SYNC.md: no iCloud here. A Developer ID app reaches an iCloud container only through an embedded
       Developer ID profile listing it, which the DMG and its updater do not carry: the DMG syncs with a sync code
       (src/icloud.rs answers "unsupported" in the updater build). -->
</dict>
</plist>
