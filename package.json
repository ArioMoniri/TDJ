{
  "name": "tdj",
  "private": true,
  "version": "0.1.0",
  "description": "TDJ — Tango DJ playlist composer: tandas, cortinas, energy arcs, exports to Spotify and DJ apps.",
  "release": {
    "repo": "ArioMoniri/TDJ",
    "appStoreId": "6834924534",
    "appStoreLive": false,
    "testflightUrl": "",
    "webUrl": "https://d3k5k2c1l0s5ri.cloudfront.net"
  },
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@tdj/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "index:build": "python3 scripts/build_index.py && pnpm --filter @tdj/core exec tsx ../../scripts/audit_streams.ts",
    "index:enrich": "pnpm --filter @tdj/core exec tsx ../../scripts/enrich_spotify.ts",
    "orchestra:import": "pnpm --filter @tdj/core exec tsx ../../scripts/import_orchestra.ts",
    "popularity:build": "pnpm --filter @tdj/core exec tsx ../../scripts/build_popularity.ts",
    "knowledge:succession": "pnpm --filter @tdj/core exec tsx ../../scripts/build_succession.ts",
    "artwork:build": "pnpm --filter @tdj/core exec tsx ../../scripts/build_artwork.ts",
    "compose": "pnpm --filter @tdj/core exec tsx src/cli.ts",
    "quality": "pnpm --filter @tdj/core exec tsx src/quality.ts",
    "e2e": "pnpm --filter @tdj/web e2e",
    "media": "pnpm --filter @tdj/web media",
    "readme:check": "node scripts/check-readme.mjs",
    "spotify:check": "pnpm --filter @tdj/web spotify:check",
    "video": "pnpm --filter @tdj/video render",
    "deploy": "sst deploy --stage production",
    "tdj": "node packages/cli/bin/tdj.mjs",
    "version:check": "node scripts/release/version.mjs --check",
    "release:version": "node scripts/release/version.mjs --set",
    "store:shots": "pnpm --filter @tdj/desktop store:shots",
    "store:banner": "pnpm --filter @tdj/desktop store:banner"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "sst": "^4.17.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
